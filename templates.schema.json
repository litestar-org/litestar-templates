{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Litestar starter templates manifest",
  "type": "object",
  "required": ["templates"],
  "properties": {
    "$schema": { "type": "string" },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "directory", "title", "description", "icon"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "Template identifier used by tooling (e.g. `litestar new <name>`)."
          },
          "directory": {
            "type": "string",
            "description": "Folder in this repository containing the template."
          },
          "title": {
            "type": "string",
            "description": "Human-readable display name (used by litestar.dev)."
          },
          "description": { "type": "string" },
          "icon": {
            "type": "string",
            "pattern": "^i-[a-z0-9-]+$",
            "description": "Iconify icon name (used by litestar.dev)."
          },
          "featured": {
            "type": "boolean",
            "description": "Highlight as the recommended starter (used by litestar.dev)."
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
